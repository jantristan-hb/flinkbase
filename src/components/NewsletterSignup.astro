---
import { strings } from "@/lib/strings";
---

<section class="rounded-lg border border-zinc-200 bg-zinc-50 p-6">
  <h2 class="text-lg font-semibold">{strings.newsletterTitle}</h2>
  <form method="POST" action="/api/newsletter" class="mt-3 flex gap-2">
    <input type="email" name="email" required placeholder={strings.newsletterPlaceholder}
      class="flex-1 rounded-md border border-zinc-300 px-3 py-2 text-sm focus:border-zinc-500 focus:outline-none focus:ring-1 focus:ring-zinc-500" />
    <button type="submit" class="rounded-md bg-zinc-900 px-4 py-2 text-sm font-medium text-white hover:bg-zinc-700">
      {strings.newsletterButton}
    </button>
  </form>
  <p class="mt-2 text-xs text-zinc-500">{strings.newsletterDisclaimer}</p>
</section>
