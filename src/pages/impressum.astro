import { strings } from "@/lib/strings";
export const prerender = true;
const seo = pageSEO(strings.imprintTitle, "Impressum — flinkbase.com", "/impressum");
---
<Layout seo={seo}>
  <h1 class="mb-6 text-2xl font-bold">{strings.imprintTitle}</h1>
  <div class="prose prose-zinc max-w-none">
    <h2>Angaben gemäß § 5 TMG</h2>
    <p>Jan-Tristan Rudat<br />Eggerstedter Weg 18<br />25421 Pinneberg</p>
    <h2>Kontakt</h2>
    <p>E-Mail: jr@dangerously.ai</p>
    <h2>Inhaltlich Verantwortlicher</h2>
    <p>Jan-Tristan Rudat (gem. § 18 Abs. 2 MStV)</p>
    <h2>Haftungsausschluss</h2>
    <p>Die Inhalte dieser Website werden mit Hilfe von künstlicher Intelligenz erstellt und kuratiert. Die Zusammenfassungen basieren auf öffentlich zugänglichen Quellen (Hacker News). Trotz sorgfältiger Aufbereitung übernehmen wir keine Gewähr für die Richtigkeit, Vollständigkeit und Aktualität der bereitgestellten Informationen.</p>
    <h2>Urheberrecht</h2>
    <p>Die durch den Betreiber erstellten Inhalte und Werke auf diesen Seiten unterliegen dem deutschen Urheberrecht. Die Zusammenfassungen stellen eigenständige redaktionelle Leistungen dar. Verlinkungen auf Originalquellen erfolgen im Rahmen des Zitatrechts.</p>
