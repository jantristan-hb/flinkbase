---
import Layout from "@/components/Layout.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import StoryItem from "@/components/StoryItem.astro";
import DigestNav from "@/components/DigestNav.astro";
import NewsletterSignup from "@/components/NewsletterSignup.astro";
import { getDigestWithStories, getPrevNextDigest } from "@/db/queries";
import { digestSEO, newsArticleJsonLd } from "@/lib/seo";
import { parseDigestSlug, formatDateLong, formatMonthYear, isOlderThanDays } from "@/lib/date";
import { strings } from "@/lib/strings";

const { slug } = Astro.params;
const parsed = parseDigestSlug(slug as string);
if (!parsed) return Astro.redirect("/404");

const result = await getDigestWithStories(parsed.date, parsed.slot);
if (!result) return Astro.redirect("/404");

const { digest, stories: digestStories } = result;
const { prev, next } = await getPrevNextDigest(digest.publishedAt);
const paywalled = isOlderThanDays(digest.publishedAt, 7);
const seo = digestSEO(digest);
const jsonLd = newsArticleJsonLd(digest);
const dateParts = parsed.date.split("-").map(Number);
---

<Layout seo={seo} jsonLd={jsonLd}>
  <Breadcrumb items={[
    { label: "Home", href: "/" },
    { label: strings.archivTitle, href: "/archiv" },
    { label: formatMonthYear(dateParts[0], dateParts[1]), href: `/archiv/${dateParts[0]}/${String(dateParts[1]).padStart(2, "0")}` },
    { label: `${formatDateLong(parsed.date)} ${strings.slotLabels[parsed.slot]}` },
  ]} />

  <article>
    <header class="mb-8">
      <time class="text-sm text-zinc-500" datetime={digest.publishedAt.toISOString()}>
        {formatDateLong(digest.publishedAt)} · {strings.slotLabels[digest.slot]}
      </time>
      <h1 class="mt-1 text-2xl font-bold leading-tight">{digest.title}</h1>
    </header>

    {paywalled ? (
      <div class="rounded-lg border border-zinc-200 bg-zinc-50 p-8 text-center">
        <h2 class="text-xl font-semibold">{strings.paywallTitle}</h2>
        <p class="mt-2 text-zinc-600">{strings.paywallText}</p>
        {digestStories.length > 0 && (
          <div class="mt-6 text-left border-t border-zinc-200 pt-4">
            <StoryItem story={digestStories[0]} />
          </div>
        )}
      </div>
    ) : (
      <>
        <div class="divide-y divide-zinc-100">
          {digestStories.map((story) => <StoryItem story={story} />)}
        </div>
        {digest.summaryOfDay && (
          <div class="mt-6 rounded-lg border-l-4 border-zinc-900 bg-zinc-50 p-4">
            <p class="text-sm font-semibold text-zinc-500">{strings.dayInsightLabel}</p>
            <p class="mt-1 text-zinc-700">{digest.summaryOfDay}</p>
          </div>
        )}
      </>
    )}
  </article>
  <DigestNav prev={prev} next={next} />
  <div class="mt-12"><NewsletterSignup /></div>
</Layout>
